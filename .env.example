MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/rockbreakers
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=development
PORT=5000
SEED_ON_BOOT=false

# Optional. Set it and images go to Cloudinary instead of MongoDB.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
